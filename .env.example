# Decisions always go to OpenRouter Decisions API (not Chat Completions, not a TypeSafe account).
OPENROUTER_API_KEY=
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# OpenRouter model *slug* sent in the Decisions body. typesafe/jev-1.13 is an OpenRouter
# model id (provider field may say TypeSafe); it does NOT switch backends or bypass OpenRouter.
OPENROUTER_MODEL=typesafe/jev-1.13
# Optional legacy alias for the same slug; OPENROUTER_MODEL wins when set. Not a separate provider.
# TYPESAFE_MODEL=typesafe/jev-1.13
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
